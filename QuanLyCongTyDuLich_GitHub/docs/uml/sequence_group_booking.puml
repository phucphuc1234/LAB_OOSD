@startuml
skinparam monochrome true
actor "Khách đoàn" as Customer
boundary "BookingForm" as UI
control "TravelService" as S
database "SQL Server (Db)" as D
Customer -> UI : Chọn tour, nhập >=12 người
UI -> S : Register(BookingRequest)
S -> S : Kiểm tra tour/khách, tiền cọc, ngày đi
S -> D : BEGIN TRANSACTION (SERIALIZABLE)
S -> D : INSERT PhieuDangKy
S -> D : INSERT KhachDoan
S -> D : INSERT ThanhToan(COC)
S -> D : COMMIT
S --> UI : MaPhieu
UI --> Customer : Hiện số phiếu
alt lỗi dữ liệu hoặc SQL
 S -> D : ROLLBACK
 S --> UI : Thông báo lỗi
end
@enduml
