        <mxCell id="SD01-message-label-19" value="19. Hiện lỗi, không vào khu vực bảo vệ" vertex="1" parent="1" style="shape=rectangle;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontColor=#000000;fontSize=14;fontStyle=0;">
          <mxGeometry as="geometry" x="116" y="2101" width="368" height="26" />
        </mxCell>
        <mxCell id="SD01-notes" value="Đăng nhập dùng chung ba vai trò; token chỉ được trả sau khi cập nhật lần đăng nhập thành công.&#10;UI chỉ lưu token/user và điều hướng sau phản hồi thành công. Không trả bcrypt hash hoặc tự cấp phân công cơ sở.&#10;C tạo JWT trước updateLastLogin nhưng nếu bước SQL này thất bại thì controller trả lỗi, không trả token cho UI. Các lỗi dịch vụ khác được báo lỗi thay vì mở khu vực được bảo vệ.&#10;Căn cứ: server/services/authService.js:38; server/repositories/authRepository.js:4; server/repositories/authRepository.js:284; server/utils/jwt.js:20." vertex="1" parent="1" style="shape=rectangle;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontColor=#000000;fontSize=12;fontStyle=0;">
          <mxGeometry as="geometry" x="25" y="2365" width="1725" height="92" />
        </mxCell>
