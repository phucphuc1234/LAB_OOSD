        </mxCell>
        <mxCell id="SD14-notes" value="Ghi trực tiếp hoặc theo lịch; nhánh retry API khớp trả bản cũ, chỉ nhánh mới tác động tồn.&#10;Control gộp middleware/controller/service/repository. Trước SP kiểm tra cú pháp, thời gian không tương lai và quyền cơ sở/hồ sơ; không precheck tồn để chặn retry.&#10;SP tìm mũi trùng dưới khóa trước các điều kiện chỉ dành cho ghi mới. Retry không phải nút sửa mũi; là yêu cầu ghi bị gửi lại.&#10;Ngày tiêm không bắt buộc trùng giờ hẹn. Đã lên lịch hoặc Đã xác nhận đều dùng được. Liều giữ cho chính lịch vẫn được chọn dù không còn liều chưa giữ.&#10;SQL nhánh mới kiểm tra cơ sở/triển khai, vaccine, chống chỉ định, lịch/lô, hạn theo ngày Việt Nam và lượng phù hợp. Kho+mũi+audit+lịch nếu có+thông báo cùng transaction.&#10;Cả tạo mới và matched retry được controller trả HTTP201. Lỗi tải lại sau commit không hoàn tác mũi. UI/API không sửa/xóa mũi, không tự kiểm tra phác đồ.&#10;Căn cứ: client/src/pages/staff/VaccinationManagementPage.jsx:36; client/src/pages/staff/VaccinationManagementPage.jsx:53; server/services/vaccinationService.js:9; database/02-routines.sql:144." vertex="1" parent="1" style="shape=rectangle;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontColor=#000000;fontSize=12;fontStyle=0;">
          <mxGeometry as="geometry" x="25" y="3595" width="1725" height="146" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
