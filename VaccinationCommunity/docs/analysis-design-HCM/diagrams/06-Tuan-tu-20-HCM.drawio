        <mxCell id="SD08-message-label-24" value="24. Hiện lỗi; giữ trạng thái cũ" vertex="1" parent="1" style="shape=rectangle;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontColor=#000000;fontSize=14;fontStyle=0;">
          <mxGeometry as="geometry" x="116" y="2536" width="368" height="26" />
        </mxCell>
        <mxCell id="SD08-notes" value="Thông báo Website thuộc hồ sơ; đánh dấu một thông báo là lựa chọn, không tự đánh dấu cả danh sách.&#10;Control gộp route/middleware, service và repository có thật. API bảo vệ kiểm tra JWT, tài khoản/vai trò và credentialVersion hiện tại; sơ đồ tập trung nghiệp vụ sau điều kiện phiên hợp lệ.&#10;Danh sách rỗng là kết quả hợp lệ. Lỗi tải không được hiển thị thành chưa có thông báo.&#10;UI chỉ đổi DaDoc của đúng phần tử sau PATCH thành công. Không có xóa/đánh dấu tất cả hoặc SMS/email; lỗi lưu giữ trạng thái cũ.&#10;Căn cứ: server/services/notificationService.js:18; server/services/notificationService.js:28; server/repositories/notificationRepository.js:84; client/src/pages/citizen/NotificationPage.jsx:42." vertex="1" parent="1" style="shape=rectangle;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontColor=#000000;fontSize=12;fontStyle=0;">
          <mxGeometry as="geometry" x="25" y="2844" width="1725" height="110" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
