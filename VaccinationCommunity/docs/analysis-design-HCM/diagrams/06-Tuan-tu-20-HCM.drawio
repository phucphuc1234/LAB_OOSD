        <mxCell id="SD18-notes" value="Quản lý danh mục vaccine dùng chung dành riêng Admin; chỉ xem hoặc chọn một thao tác ghi.&#10;Mọi tài khoản đọc metadata vaccine; POST/PUT/PATCH dùng chung chỉ Admin. Nhân viên quản lý tiếp nhận vaccine theo cơ sở ở SD11.&#10;Repository lấy khóa kho rồi kiểm tra lại Admin đang hoạt động trong SERIALIZABLE; ghi VACCINE và audit nguyên tử.&#10;Ngừng vaccine bị chặn khi bất kỳ cơ sở nào còn lịch hoạt động. Không có xóa vaccine; số mũi/khoảng cách chỉ là metadata, không tự kiểm tra phác đồ.&#10;Căn cứ: server/routes/vaccineRoutes.js:31; server/services/vaccineService.js:24; server/repositories/vaccineRepository.js:85; server/repositories/vaccineRepository.js:147." vertex="1" parent="1" style="shape=rectangle;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontColor=#000000;fontSize=12;fontStyle=0;">
          <mxGeometry as="geometry" x="25" y="2653" width="1725" height="110" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
