        <mxCell id="SD11-notes" value="Xem cơ sở được phép và danh mục tiếp nhận; tùy chọn bật hoặc ngừng một vaccine tại cơ sở đã chọn.&#10;GET cơ sở mặc định chỉ trả các cơ sở/khu vực hoạt động trong phạm vi: nhân viên được phân công, admin toàn hệ thống. Danh sách rỗng là kết quả hợp lệ; không mở nhánh sửa nếu chưa chọn được cơ sở.&#10;Bật tiếp nhận không yêu cầu có tồn kho và không thay đổi số lượng kho. Tồn khả dụng chỉ là điều kiện bổ sung khi người dân đặt lịch.&#10;Ngừng tiếp nhận bị từ chối nếu còn lịch hoạt động cho vaccine tại cơ sở. Giao dịch lấy Inventory application lock, kiểm tra lại tài khoản/phân công và điều kiện, rồi lưu trạng thái cùng audit.&#10;UI đổi công tắc lạc quan trong lúc chờ API; API thất bại thì khôi phục giá trị cũ. Danh mục chung vẫn do Admin quản lý.&#10;Căn cứ: server/routes/facilityRoutes.js:14; server/services/facilityService.js:29; server/services/facilityService.js:44; server/repositories/facilityRepository.js:41." vertex="1" parent="1" style="shape=rectangle;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontColor=#000000;fontSize=12;fontStyle=0;">
          <mxGeometry as="geometry" x="25" y="3023" width="1725" height="128" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
