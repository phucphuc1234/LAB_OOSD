        <mxCell id="SD10-notes" value="Danh sách và chi tiết người dân đều giới hạn theo phạm vi; tìm/lọc là thao tác trình duyệt.&#10;Control gộp route/middleware, service và repository có thật. API bảo vệ kiểm tra JWT, tài khoản/vai trò và credentialVersion hiện tại; sơ đồ tập trung nghiệp vụ sau điều kiện phiên hợp lệ.&#10;Nhân viên chỉ tra hồ sơ có lịch/mũi tại cơ sở được giao, kể cả quan hệ lịch sử; Admin tra toàn hệ thống. Biết mã hồ sơ không mở quyền truy cập.&#10;Đọc hồ sơ không cấp quyền xem mọi mũi/phiếu của người đó ở cơ sở khác. Module này chỉ đọc, không tạo/sửa/xóa hồ sơ.&#10;Căn cứ: server/services/citizenService.js:22; server/repositories/citizenRepository.js:87; server/repositories/citizenRepository.js:119; database/06-facilities.sql:120." vertex="1" parent="1" style="shape=rectangle;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontColor=#000000;fontSize=12;fontStyle=0;">
          <mxGeometry as="geometry" x="25" y="2125" width="1725" height="110" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
