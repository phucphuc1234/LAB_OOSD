        <mxCell id="SD13-notes" value="Xem lịch; tùy chọn tạo/sửa hoặc xác nhận/hủy/vắng, theo phạm vi cơ sở.&#10;Tạo/sửa và đổi trạng thái là lựa chọn, không buộc thực hiện tất cả. Chỉ xem không ghi dữ liệu.&#10;Tạo/sửa kiểm tra người/vaccine/cơ sở, thời gian tương lai, trùng lịch/mũi và chống chỉ định. Không chuyển lịch sang người dân khác.&#10;FEFO chọn khi ứng viên lô NULL; sửa cùng vaccine/cơ sở có thể giữ lô cũ. Đổi vaccine/cơ sở cần chọn lại; giải phóng/giữ mới trong cùng giao dịch.&#10;Hủy/vắng giải phóng giữ chỗ; vắng chỉ khi tới giờ hẹn. UI không cho tự chọn Đã tiêm/Hoàn thành. Không có suất khung giờ và không tự tạo thông báo đặt/hủy.&#10;Căn cứ: server/services/scheduleService.js:48; server/repositories/scheduleRepository.js:8; database/02-routines.sql:9; database/02-routines.sql:98." vertex="1" parent="1" style="shape=rectangle;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontColor=#000000;fontSize=12;fontStyle=0;">
          <mxGeometry as="geometry" x="25" y="2653" width="1725" height="128" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
