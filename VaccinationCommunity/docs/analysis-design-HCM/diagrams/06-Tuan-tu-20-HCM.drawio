        <mxCell id="SD05-notes" value="Đọc hồ sơ chính mình; tùy chọn cập nhật liên hệ/địa chỉ, không đổi định danh.&#10;Control gộp route/middleware, service và repository có thật. API bảo vệ kiểm tra JWT, tài khoản/vai trò và credentialVersion hiện tại; sơ đồ tập trung nghiệp vụ sau điều kiện phiên hợp lệ.&#10;Không nhận mã người dân để đổi chủ hồ sơ; họ tên, ngày sinh, giới tính, CCCD/BHYT không nằm trong allowlist sửa.&#10;SELECT lại hồ sơ ở repository có khóa, UPDATE hồ sơ+tài khoản và audit nằm cùng transaction. GET tải lại sau phản hồi thành công là bước riêng; lỗi đọc sau commit không rollback thay đổi đã lưu.&#10;Căn cứ: server/services/citizenService.js:3; server/services/citizenService.js:8; server/repositories/citizenRepository.js:44; client/src/pages/citizen/ProfilePage.jsx:65." vertex="1" parent="1" style="shape=rectangle;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontColor=#000000;fontSize=12;fontStyle=0;">
          <mxGeometry as="geometry" x="25" y="3288" width="1725" height="110" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
