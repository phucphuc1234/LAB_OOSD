        <mxCell id="PR27-n17" value="Khóa/mở khóa là đổi trạng thái, không xóa tài khoản. Middleware đọc trạng thái hiện tại từ DB để chặn cả yêu cầu đang có token cũ." style="shape=rectangle;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=14;fontColor=#111111;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
