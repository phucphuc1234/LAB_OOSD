        <mxCell id="UC12-v64" value="Cảnh báo đỏ xuất hiện trước khi gửi; không chờ cổng phản hồi khi cần trợ giúp. Mỗi lần gửi tạo phiếu riêng; lỗi đọc sau commit không hoàn tác phiếu.&#10;Control gộp các module controller/service/repository; đây là mô hình BCE, không phải các lớp ORM trong code." style="shape=rectangle;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=12;fontColor=#000000;fontStyle=0;align=left;verticalAlign=middle;" parent="1" vertex="1">
